{
  "status": "draft — issue #509, epic #507; no device reads this file yet. Format: docs/records/design-reviews/io-contract-modules.md > 5.",
  "contract": 1,
  "module": "plan",
  "kind": "evaluation",
  "goal": "Scores of the design's intent — whether each decision is grounded, whether each criterion's verification fits it and whether the scope is right — never the method by which the design was reached.\n",
  "procedure": "docs/evaluation-system.md > Gate rubrics — GATE:HYPOTHESIS, GATE:PLAN, AUDIT, GATE:QUALITY > GATE:PLAN",
  "evaluator": {
    "agent": "autoflow-evaluator",
    "spawn": "fresh, every run"
  },
  "params": {
    "issue": {
      "type": "issue-number",
      "required": true
    }
  },
  "inputs": {
    "feature_design": {
      "required": true,
      "from": {
        "module": "design",
        "output": "feature_design"
      }
    },
    "verification_design": {
      "required": true,
      "from": {
        "module": "design",
        "output": "verification_design"
      }
    },
    "applied_criteria": {
      "required": true,
      "from": {
        "module": "criteria-apply",
        "output": "applied_criteria"
      }
    },
    "decisions": {
      "required": false,
      "from": {
        "ledger": [
          "ac-decision"
        ]
      }
    },
    "previous_evaluation": {
      "required": false,
      "from": {
        "module": "plan",
        "output": "evaluation"
      },
      "note": "previous_evaluation is given on a re-score; its unchanged items are inherited by citation."
    }
  },
  "outputs": {
    "evaluation": {
      "file": "evaluation.json",
      "format": "json",
      "writer": "the invoking session, writing the report the evaluator returns verbatim — the evaluator holds no Write tool, so its return value is the only delivery path for its scores (docs/role-contracts.md > Evaluation AI). Q7.\n",
      "keys": {
        "type": {
          "type": "string",
          "required": true,
          "const": "plan_evaluation"
        },
        "target": {
          "type": "string",
          "required": true
        },
        "issue": {
          "type": "string",
          "required": true,
          "pattern": "^#[0-9]+$"
        },
        "scores": {
          "type": "object",
          "required": true,
          "keys_exactly": [
            "Decision grounds",
            "Verification fit",
            "Scope",
            "Security"
          ],
          "value": "a number 0-10, or { score, reason }"
        },
        "rescore": {
          "type": "object",
          "required_when": "previous_evaluation is given",
          "keys": [
            "source",
            "rescored",
            "inherited",
            "prior_findings"
          ],
          "rules": [
            "every rubric item is in exactly one of rescored and inherited",
            "every finding of previous_evaluation has an entry in prior_findings, with its disposition"
          ]
        },
        "summary": {
          "type": "string",
          "required": true
        },
        "recommendations": {
          "type": "array",
          "required": true,
          "items": {
            "keys": [
              "subject",
              "item",
              "finding"
            ]
          }
        }
      },
      "forbidden_keys": [
        "verdict"
      ],
      "check": "mechanical"
    }
  },
  "reference": {
    "pass": {
      "average_at_least": 7.5,
      "each_item_at_least": 7,
      "security_rework_at_or_below": 3
    },
    "source": "docs/evaluation-system.md > PASS Criteria",
    "note": "Q2: AutoFlow provides these with the evaluation; applying them is the Coordinator's."
  },
  "result": {
    "summary": "one line"
  }
}
