{
  "status": "draft — issue #509, epic #507; read by scripts/contracts/contract.sh and the module's command. Format: docs/records/design-reviews/io-contract-modules.md > 5.",
  "contract": 1,
  "module": "audit",
  "kind": "evaluation",
  "reads_records": false,
  "goal": "A judgment of whether the build's tests failed before the implementation where they were meant to, and scores of the change on the project's security items.\n",
  "procedure": "docs/evaluation-system.md > Gate rubrics — GATE:HYPOTHESIS, GATE:PLAN, AUDIT, GATE:QUALITY > AUDIT",
  "evaluator": {
    "agent": "autoflow-evaluator",
    "spawn": "fresh, every run"
  },
  "params": {
    "issue": {
      "type": "issue-number",
      "required": true
    }
  },
  "inputs": {
    "commits": {
      "required": true,
      "from": {
        "module": "build",
        "output": "commits"
      }
    },
    "build_report": {
      "required": true,
      "from": {
        "module": "build",
        "output": "report"
      }
    },
    "verification_design": {
      "required": true,
      "from": {
        "module": "design",
        "output": "verification_design"
      }
    },
    "security_checklist": {
      "required": false,
      "from": {
        "path": "invocation"
      },
      "note": "the target's checklist at the version security-checklist.sh status names (score=), written to a file in the record directory (git show <score>); not given when none is declared"
    },
    "previous_evaluation": {
      "required": false,
      "from": {
        "module": "audit",
        "output": "evaluation"
      }
    }
  },
  "outputs": {
    "evaluation": {
      "file": "evaluation.json",
      "format": "json",
      "note": "the evaluator, writing into the output directory its prompt names (Q7, revised 2026-10-26)",
      "checks": [
        {
          "type": "keys",
          "spec": {
            "type": {
              "type": "string",
              "required": true,
              "const": "security_audit"
            },
            "issue": {
              "type": "string",
              "required": true,
              "pattern": "^#[0-9]+$"
            },
            "test_first": {
              "type": "object",
              "required": true,
              "keys_exactly": [
                "confirmed",
                "read"
              ],
              "note": "what the evaluator read, and whether it confirms that the tests meant to fail before the implementation did; when it does not, no scores are given"
            },
            "scores": {
              "type": "object",
              "keys_exactly": [
                "Authn/Authz",
                "Input validation",
                "Data exposure",
                "Infra isolation",
                "Dependencies"
              ],
              "note": "each value a number 0-10, or { score, reason }",
              "required_when": {
                "key": ".test_first.confirmed",
                "equals": true
              }
            },
            "rescore": {
              "type": "object",
              "required_when": {
                "input": "previous_evaluation"
              }
            },
            "summary": {
              "type": "string",
              "required": true
            },
            "recommendations": {
              "type": "array",
              "required": true,
              "items_keys": [
                "subject",
                "item",
                "finding"
              ]
            }
          }
        },
        {
          "type": "forbidden_keys",
          "keys": [
            "verdict"
          ],
          "note": "Q2: the evaluation outputs scores and their grounds; the pass values travel in reference"
        },
        {
          "type": "partition",
          "when": {
            "input": "previous_evaluation"
          },
          "of_keys": ".scores",
          "into": [
            ".rescore.rescored",
            ".rescore.inherited"
          ],
          "note": "every rubric item is scored afresh or inherited"
        },
        {
          "type": "covers",
          "when": {
            "input": "previous_evaluation"
          },
          "source": {
            "input": "previous_evaluation",
            "ids": ".recommendations[].finding"
          },
          "by": ".rescore.prior_findings[].finding",
          "disposed_by": ".rescore.prior_findings[].disposition",
          "note": "every finding of the previous evaluation has its disposition; which entry answers which finding the evaluation states in its own words",
          "count_only": true
        }
      ]
    }
  },
  "reference": {
    "pass": {
      "average_at_least": 7.5,
      "each_item_at_least": 7
    },
    "source": "docs/evaluation-system.md > PASS Criteria"
  }
}
