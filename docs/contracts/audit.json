{
  "status": "draft — issue #509, epic #507; no device reads this file yet. Format: docs/records/design-reviews/io-contract-modules.md > 5.",
  "contract": 1,
  "module": "audit",
  "kind": "evaluation",
  "goal": "A judgment of whether the build's tests failed before the implementation where they were meant to, and scores of the change on the project's security items.\n",
  "procedure": "docs/evaluation-system.md > Gate rubrics — GATE:HYPOTHESIS, GATE:PLAN, AUDIT, GATE:QUALITY > AUDIT",
  "evaluator": {
    "agent": "autoflow-evaluator",
    "spawn": "fresh, every run"
  },
  "params": {
    "issue": {
      "type": "issue-number",
      "required": true
    }
  },
  "inputs": {
    "commits": {
      "required": true,
      "from": {
        "module": "build",
        "output": "commits"
      }
    },
    "build_report": {
      "required": true,
      "from": {
        "module": "build",
        "output": "report"
      }
    },
    "verification_design": {
      "required": true,
      "from": {
        "module": "design",
        "output": "verification_design"
      }
    },
    "security_checklist": {
      "required": false,
      "from": {
        "path": "target"
      }
    },
    "previous_evaluation": {
      "required": false,
      "from": {
        "module": "audit",
        "output": "evaluation"
      }
    }
  },
  "outputs": {
    "evaluation": {
      "file": "evaluation.json",
      "format": "json",
      "writer": "the invoking session, writing the report the evaluator returns verbatim (Q7)",
      "keys": {
        "type": {
          "type": "string",
          "required": true,
          "const": "security_audit"
        },
        "issue": {
          "type": "string",
          "required": true,
          "pattern": "^#[0-9]+$"
        },
        "test_first": {
          "type": "string",
          "required": true,
          "note": "what the evaluator read and whether it confirms test-first; when it does not, no scores are given"
        },
        "scores": {
          "type": "object",
          "required_when": "test_first confirms",
          "keys_exactly": [
            "Authn/Authz",
            "Input validation",
            "Data exposure",
            "Infra isolation",
            "Dependencies"
          ],
          "value": "a number 0-10, or { score, reason }"
        },
        "rescore": {
          "type": "object",
          "required_when": "previous_evaluation is given",
          "keys": [
            "source",
            "rescored",
            "inherited",
            "prior_findings"
          ],
          "rules": [
            "every rubric item is in exactly one of rescored and inherited",
            "every finding of previous_evaluation has an entry in prior_findings, with its disposition"
          ]
        },
        "summary": {
          "type": "string",
          "required": true
        },
        "recommendations": {
          "type": "array",
          "required": true,
          "items": {
            "keys": [
              "subject",
              "item",
              "finding"
            ]
          }
        }
      },
      "forbidden_keys": [
        "verdict"
      ],
      "check": "mechanical"
    }
  },
  "reference": {
    "pass": {
      "average_at_least": 7.5,
      "each_item_at_least": 7
    },
    "source": "docs/evaluation-system.md > PASS Criteria"
  },
  "result": {
    "summary": "one line"
  }
}
