{
  "status": "draft — issue #509, epic #507; read by scripts/contracts/contract.sh and the module's command. Format: docs/records/design-reviews/io-contract-modules.md > 5.",
  "contract": 1,
  "module": "quality",
  "kind": "evaluation",
  "reads_records": false,
  "goal": "Scores of the built change against the acceptance criteria, the design and the build's own records — complete, correct, verified, within the cycle's scope, committed and documented.\n",
  "procedure": "docs/evaluation-system.md > Gate rubrics — GATE:HYPOTHESIS, GATE:PLAN, AUDIT, GATE:QUALITY > GATE:QUALITY",
  "evaluator": {
    "agent": "autoflow-evaluator",
    "spawn": "fresh, every run"
  },
  "params": {
    "issue": {
      "type": "issue-number",
      "required": true
    }
  },
  "inputs": {
    "commits": {
      "required": true,
      "from": {
        "module": "build",
        "output": "commits"
      }
    },
    "applied_criteria": {
      "required": true,
      "from": {
        "module": "criteria-apply",
        "output": "applied_criteria"
      }
    },
    "analysis": {
      "required": true,
      "from": {
        "module": "analysis",
        "output": "report"
      }
    },
    "feature_design": {
      "required": true,
      "from": {
        "module": "design",
        "output": "feature_design"
      }
    },
    "verification_design": {
      "required": true,
      "from": {
        "module": "design",
        "output": "verification_design"
      }
    },
    "build_report": {
      "required": true,
      "from": {
        "module": "build",
        "output": "report"
      }
    },
    "audit_evaluation": {
      "required": true,
      "from": {
        "module": "audit",
        "output": "evaluation"
      }
    },
    "deferred": {
      "required": false,
      "from": {
        "path": "invocation"
      },
      "note": "a JSON array of the recommendations deferred or separated after earlier evaluations, each {subject, finding, disposition} (Q1: the triage result is a content input; the form is delivery.json's)"
    },
    "decisions": {
      "required": false,
      "from": {
        "ledger": [
          "ac-decision"
        ]
      }
    },
    "previous_evaluation": {
      "required": false,
      "from": {
        "module": "quality",
        "output": "evaluation"
      }
    }
  },
  "outputs": {
    "evaluation": {
      "file": "evaluation.json",
      "format": "json",
      "note": "the invoking session, writing the report the evaluator returns verbatim (Q7)",
      "checks": [
        {
          "type": "keys",
          "spec": {
            "type": {
              "type": "string",
              "required": true,
              "const": "quality_evaluation"
            },
            "issue": {
              "type": "string",
              "required": true,
              "pattern": "^#[0-9]+$"
            },
            "scores": {
              "type": "object",
              "keys_exactly": [
                "Completeness",
                "Quality",
                "Test coverage",
                "Test quality",
                "Security",
                "Fit",
                "Impact scope",
                "Minimal implementation",
                "Commit conventions",
                "Doc updates"
              ],
              "note": "each value a number 0-10, or { score, reason }",
              "required": true
            },
            "rescore": {
              "type": "object",
              "required_when": {
                "input": "previous_evaluation"
              }
            },
            "refine_observations": {
              "type": "array",
              "required": true,
              "items_keys": [
                "entry",
                "disposition"
              ],
              "note": "the evaluator's disposition of every entry of the build report's \"## Out-of-scope observations — guard / boundary logic touched\" section; [] when it says none (Q14)"
            },
            "summary": {
              "type": "string",
              "required": true
            },
            "recommendations": {
              "type": "array",
              "required": true,
              "items_keys": [
                "subject",
                "item",
                "finding"
              ]
            }
          }
        },
        {
          "type": "forbidden_keys",
          "keys": [
            "verdict"
          ],
          "note": "Q2: the evaluation outputs scores and their grounds; the pass values travel in reference"
        },
        {
          "type": "partition",
          "when": {
            "input": "previous_evaluation"
          },
          "of_keys": ".scores",
          "into": [
            ".rescore.rescored",
            ".rescore.inherited"
          ],
          "note": "every rubric item is scored afresh or inherited"
        },
        {
          "type": "covers",
          "when": {
            "input": "previous_evaluation"
          },
          "source": {
            "input": "previous_evaluation",
            "ids": ".recommendations[].finding"
          },
          "by": ".rescore.prior_findings[].finding",
          "disposed_by": ".rescore.prior_findings[].disposition",
          "note": "every finding of the previous evaluation has its disposition"
        }
      ]
    }
  },
  "reference": {
    "pass": {
      "average_at_least": 7.5,
      "each_item_at_least": 7,
      "security_rework_at_or_below": 3
    },
    "source": "docs/evaluation-system.md > PASS Criteria"
  },
  "result": {
    "summary": "one line"
  }
}
