set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The single assertion form this fixture uses. No other assertion mechanism
# exists anywhere in this file.
probe_assert() {
  local expected="$1" actual="$2"
  [ "$expected" = "$actual" ]
}

