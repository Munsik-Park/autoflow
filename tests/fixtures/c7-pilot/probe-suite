# Covered branch: its sentinel is asserted through probe_assert.
probe_assert "PROBE_S3_COVERED" "$covered_output"

# Planted branch: its output is captured above (exercised) but its sentinel
# never appears on a probe_assert-invoking line — deliberately unasserted.
echo "planted branch produced: $planted_output"

# Bring both step-4 mock shims into scope (never actually invoked here —
