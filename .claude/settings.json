{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-autoflow-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-read-dedup.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "autoflow": {
      "source": {
        "source": "github",
        "repo": "Munsik-Park/autoflow"
      }
    }
  },
  "enabledPlugins": {
    "autoflow@autoflow": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
